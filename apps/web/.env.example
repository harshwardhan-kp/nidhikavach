# Postgres on the shared VM (TLS required)
DATABASE_URL=postgres://nidhikavach:<password>@freevm-harshw-6d62.indiasouthcentral.cloudapp.azure.com:5432/nidhikavach?sslmode=require
# 32+ random bytes, hex
SESSION_SECRET=
# FastAPI sidecar on the VM (key lives in /etc/nidhikavach/sidecar.env on the VM)
SIDECAR_URL=https://nidhikavach.172-198-62-117.sslip.io
SIDECAR_API_KEY=
# HMAC key for browser upload/download tokens (same value as on the VM)
SIDECAR_URL_SIGNING_KEY=
# Azure Document Intelligence (F0) for scan reading
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# Plain-language search, Doc-AI second reader, drafting
OPENAI_API_KEY=
# 1 = one-click demo accounts + demo clock
DEMO_MODE=1
# Vercel Cron sends this as a bearer token to /api/cron/lifecycle
CRON_SECRET=
