[Unit]
Description=NidhiKavach sidecar (FastAPI)
After=network.target postgresql.service

[Service]
User=nidhikavach
Group=nidhikavach
WorkingDirectory=/opt/nidhikavach/sidecar
EnvironmentFile=/etc/nidhikavach/sidecar.env
ExecStart=/opt/nidhikavach/sidecar/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8300 --workers 1 --proxy-headers
Restart=on-failure
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nidhikavach
PrivateTmp=true

[Install]
WantedBy=multi-user.target
